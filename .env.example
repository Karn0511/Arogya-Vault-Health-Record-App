# Arogya Vault Environment Configuration Template
# Copy this file to .env and fill in your actual values

# JWT and Session Secrets (Generate strong secrets for production)
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=your_password_here
MONGO_INITDB_DATABASE=arogya
MONGO_URI=mongodb://admin:password@localhost:27017/arogya?authSource=admin

# Backend Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:80

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Gemini AI Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Phone.email OTP Service Configuration
# Sign up at: https://phone.email
PHONE_EMAIL_CLIENT_ID=your_client_id_here
PHONE_EMAIL_API_KEY=your_api_key_here

# Auto-deletion Service (optional)
# AUTO_DELETE_ENABLED=true
# AUTO_DELETE_DAYS=180

# Mongo Express Configuration
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=your_password_here
