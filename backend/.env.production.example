##############################################
# Production environment example - DO NOT commit real secrets
##############################################

# Server
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com
FRONTEND_URL=https://your-frontend-domain.com

# Database (MongoDB Atlas recommended)
# MONGO_URI must be a full connection string with SRV or standard URI
# Example: mongodb+srv://<user>:<password>@cluster0.mongodb.net/arogya?retryWrites=true&w=majority
MONGO_URI=

# Security
# Use a cryptographically strong random string (32+ bytes base64 or hex)
JWT_SECRET=
SESSION_SECRET=

# Google Gemini AI (or other AI provider)
GEMINI_API_KEY=

# AWS (for S3 storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=arogya-vault-files

# Google OAuth (if using social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone/email OTP provider credentials (e.g., phone.email)
PHONE_EMAIL_CLIENT_ID=
PHONE_EMAIL_API_KEY=

# Email (SMTP) - consider using a transactional email provider (SendGrid, SES)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# Uploads and file limits
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800
ALLOWED_FILE_TYPES=jpg,png,pdf,doc,docx

# Auto deletion (data retention)
AUTO_DELETE_ENABLED=true
AUTO_DELETE_DAYS=180

# Optional: static preissued token for automation (not recommended for prod)
STATIC_JWT_TOKEN=

# Notes:
# - Store real secrets in your deployment platform's secrets manager (Render, GitHub Secrets, Kubernetes Secrets, AWS Secrets Manager)
# - Rotate keys regularly and restrict IAM permissions for S3 to the minimum required.
