PORT=5000
MONGO_URI=mongodb://<username>:<password>@<host>:27017/arogya?authSource=admin
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
NODE_ENV=production
CORS_ORIGIN=https://your-frontend-domain.com

# Gemini AI Configuration (set in Render/GitHub Secrets)
GEMINI_API_KEY=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=arogya-vault-files

# Phone.email OTP Configuration
PHONE_EMAIL_CLIENT_ID=
PHONE_EMAIL_API_KEY=

# Optional: Email SMTP
EMAIL_USER=
EMAIL_PASS=

# Auto deletion
AUTO_DELETE_ENABLED=true
AUTO_DELETE_DAYS=180

# Notes: Do NOT commit real secrets. Use your host/service env management.
